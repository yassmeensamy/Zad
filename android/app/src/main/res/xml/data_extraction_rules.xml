<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31) counterpart to android:allowBackup="false": excludes
     every domain from both cloud backup and device-to-device transfer, so no
     app data (tokens, cached quiz progress, prefs) leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
